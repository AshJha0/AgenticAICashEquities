  "backtest.run_backtest": {
    "annotations": {
      "readOnlyHint": true,
      "requiredCapabilities": [],
      "riskLevel": "LOW"
    },
    "description": "Backtest the signal's quantile portfolio from the enumerated search space: decide at the close, fill execution_lag_days later at the close or open, drift weights between fills, charge half-spread plus square-root impact, borrow by liquidity tier and financing; report per-period Sharpe on excess returns, costs by line, capped and blocked trades, delisting bounds, the profitability table with a capacity sweep, and this run's trial-ledger record (the trial count is read from the ledger, never supplied).",
    "inputSchema": {
      "properties": {
        "capacity": {
          "default": true,
          "type": "boolean"
        },
        "cost_multiplier": {
          "default": 1.0,
          "type": "number"
        },
        "dataset": {
          "default": "R01",
          "type": "string"
        },
        "end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "execution_lag_days": {
          "default": 1,
          "type": "integer"
        },
        "fill": {
          "default": "close",
          "type": "string"
        },
        "gross_notional": {
          "default": 50000000.0,
          "type": "number"
        },
        "in_sample_end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "long_short": {
          "default": true,
          "type": "boolean"
        },
        "rebalance_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "signal": {
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "weighting": {
          "default": "equal",
          "type": "string"
        }
      },
      "required": [
        "signal"
      ],
      "type": "object"
    },
    "name": "run_backtest"
  },
