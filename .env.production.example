# Production configuration. Copy to .env and fill in real values.
# CEAP_ENV must NOT be "dev" - dev keys and auto-approve are refused outside dev
# (see Settings.validate_for_serving in src/ceap/config.py).
CEAP_ENV=production

ANTHROPIC_API_KEY=sk-ant-...
CEAP_LLM_PROVIDER=anthropic       # auto | mock | anthropic
CEAP_LLM_MODEL=claude-sonnet-4-5
# CEAP_LLM_PLANNING_MODEL=claude-opus-4-1

CEAP_DEFAULT_DATASET=T01
CEAP_STEP_TIMEOUT_SECONDS=30
CEAP_TASK_TIMEOUT_SECONDS=300
CEAP_MAX_RETRIES=2

# No default: approvals are queued for a human unless explicitly set true.
CEAP_AUTO_APPROVE=false

CEAP_MAX_CONCURRENT_INVESTIGATIONS=4
CEAP_MAX_RETAINED_RESULTS=200

# Real, unique keys per principal - never the dev-* keys from .env.example.
# Format: key:role,key:role,...  Roles: trader, quant, admin, viewer. Keys >= 8 chars.
CEAP_API_KEYS=<generate-a-long-random-key>:trader,<generate-a-long-random-key>:admin

# CEAP_KNOWLEDGE_DIR=data/reference/knowledge
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
