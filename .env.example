# Copy to .env and export, or set in your shell. All values are optional.
# ANTHROPIC_API_KEY=sk-ant-...
CEAP_LLM_PROVIDER=auto            # auto | mock | anthropic
CEAP_LLM_MODEL=claude-sonnet-4-5
# CEAP_LLM_PLANNING_MODEL=claude-sonnet-5   # recommended: a stronger planner than Haiku reduces incomplete research plans
CEAP_ENV=dev                      # dev keys + auto-approve apply only in dev
CEAP_DEFAULT_DATASET=T01
CEAP_STEP_TIMEOUT_SECONDS=30
CEAP_TASK_TIMEOUT_SECONDS=300
CEAP_MAX_RETRIES=2
CEAP_AUTO_APPROVE=true
CEAP_MAX_CONCURRENT_INVESTIGATIONS=4
CEAP_MAX_RETAINED_RESULTS=200
CEAP_API_KEYS=dev-trader-key:trader,dev-quant-key:quant,dev-admin-key:admin,dev-viewer-key:viewer
# CEAP_KNOWLEDGE_DIR=data/reference/knowledge
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
